<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.OneDay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorPrimary</item>
    </style>

    <style name="Theme.OneDay" parent="Base.Theme.OneDay" />

    <style name="Theme.OneDay.Splash" parent="Theme.OneDay">
        <item name="android:windowBackground">@color/white</item>
    </style>


    <style name="Theme.OneDay.Auth" parent="Theme.OneDay">
        <item name="android:windowBackground">@color/colorAuthBackground</item>
        <item name="android:navigationBarColor">@color/colorAuthBackground</item>
        <item name="android:navigationBarDividerColor">@color/colorAuthBackground</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <style name="Theme.OneDay.Welcome" parent="Theme.OneDay">
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarDividerColor">@color/colorPrimary</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>